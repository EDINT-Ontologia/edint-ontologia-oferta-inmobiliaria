  "http://purl.org/dc/terms/abstract" : [ {
    "@language" : "en",
    "@value" : "EDINT ontology for modelling real estate listings in the Spanish context, including property offers (sale, rent, transfer). It integrates with the Spanish Cadastre ontology."
  }, {
    "@language" : "es",
    "@value" : "Ontología EDINT para modelar ofertas inmobiliarias en el contexto español, incluyendo ofertas de inmuebles (venta, alquiler, traspaso). Se integra con la ontología del Catastro Español."
  } ],
