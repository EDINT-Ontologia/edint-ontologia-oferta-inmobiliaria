    <owl:Ontology rdf:about="http://vocab.linkeddata.es/datosabiertos/def/catastro/">
        <owl:imports rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/catastro/"/>
        <terms:abstract xml:lang="en">EDINT ontology for modelling real estate listings in the Spanish context, including property offers (sale, rent, transfer). It integrates with the Spanish Cadastre ontology.</terms:abstract>
        <terms:abstract xml:lang="es">Ontología EDINT para modelar ofertas inmobiliarias en el contexto español, incluyendo ofertas de inmuebles (venta, alquiler, traspaso). Se integra con la ontología del Catastro Español.</terms:abstract>
        <terms:bibliographicCitation xml:lang="en">EDINT Spanish Real Estate Listing Ontology. EDINT. Revision: v0.2.1.</terms:bibliographicCitation>
        <terms:bibliographicCitation xml:lang="es">Ontología EDINT de Oferta Inmobiliaria Española. EDINT. Revisión: v0.2.1.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-04-14</terms:created>
        <terms:creator rdf:nodeID="genid1"/>
        <terms:creator rdf:nodeID="genid2"/>
        <terms:creator rdf:nodeID="genid3"/>
        <terms:creator rdf:nodeID="genid4"/>
        <terms:creator rdf:nodeID="genid5"/>
        <terms:description xml:lang="en">Ontology for modeling real estate listings in the Spanish context, including property offers (sale, rent, transfer). Integrates with the Spanish Cadastre ontology.</terms:description>
        <terms:description xml:lang="es">Ontología para modelar ofertas inmobiliarias en el contexto español, incluyendo ofertas de inmuebles (venta, alquiler, traspaso). Se integra con la ontología del Catastro Español.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-26</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-26</terms:modified>
        <terms:publisher rdf:nodeID="genid6"/>
        <terms:title xml:lang="en">EDINT Spanish Real Estate Listing Ontology</terms:title>
        <terms:title xml:lang="es">Ontología EDINT de Oferta Inmobiliaria Española</terms:title>
        <vann:preferredNamespacePrefix>edintinm</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/oferta-inmobiliaria#"/>
        <rdfs:label xml:lang="es">Oferta Inmobiliaria</rdfs:label>
        <rdfs:label xml:lang="en">Real Estate Listings</rdfs:label>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-oferta-inmobiliaria/releases/tag/v0.2.0"/>
        <owl:versionInfo>0.2.1</owl:versionInfo>
        <schema:codeRepository rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-oferta-inmobiliaria"/>
        <schema:creativeWorkStatus xml:lang="en">Ontology Specification</schema:creativeWorkStatus>
        <schema:funding>Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)</schema:funding>
        <vocab:jsonldSerialization>ontology.jsonld</vocab:jsonldSerialization>
        <vocab:ntSerialization>ontology.nt</vocab:ntSerialization>
